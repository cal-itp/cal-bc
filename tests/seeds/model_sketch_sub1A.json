  {
    "model": "models.row",
    "pk": 10101010205,
    "fields": {
      "group_id": 101010102,
      "name": "Length of Peak Period",
      "position": 5,
      "guide": "<p><strong>Length of Peak Period(s)</strong></p><p>* Helps determine peak/non - peak volumes and speeds for emissions and operating cost benefit calculations.<br>* Insert the number of peak period hours per typical day. Default is 5 hours (statewide avg).<br>* This model estimates total % daily traffic occurring during peak period using a lookup table developed from Traffic Census data. No difference between weekdays and weekends.</p><p>Examples<br>* If peak period is four hours from 3PM to 7PM, then enter a “4”.<br>* To model a 24-hour HOV or HOT lane, enter 24 hours so peak is 100% of average daily traffic.<br>* To model a ramp metering project, enter the hours per day that metering is operational.</p>"
    }
  },

